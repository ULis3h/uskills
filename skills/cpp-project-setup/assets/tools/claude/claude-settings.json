{
  "$comment": "Copy to .claude/settings.json (project-wide, committed) or merge into an existing one. Requires tools/claude/*.sh to be executable.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/claude/post_edit_cpp.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/claude/stop_check_cpp.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
